# Copy to backend/.env for local development.
MONGO_URL=mongodb://localhost:27017
DB_NAME=sewain
# Long random string; signs login tokens. Changing it logs everyone out.
AUTH_SECRET=change-me-to-a-long-random-string
# Optional: enables POST /api/admin/set-plan. Leave empty to disable the endpoint.
ADMIN_SECRET=
# Optional: only needed when the web app runs on another origin (e.g. `expo start --web`).
# CORS_ORIGINS=http://localhost:8081
