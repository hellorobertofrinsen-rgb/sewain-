{
  "expo": {
    "name": "SewAIn",
    "slug": "sewain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sewain",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.sewain.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pilih foto unit untuk ditampilkan ke calon penyewa",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4F5F7"
      },
      "package": "id.sewain.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "SewAIn - Property Manager",
      "shortName": "SewAIn",
      "lang": "id",
      "themeColor": "#F4F5F7",
      "backgroundColor": "#F4F5F7",
      "description": "Kelola prospek, unit, dan tenant di satu tempat."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F7"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
